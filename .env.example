# Connection string do banco Neon (Postgres serverless)
# Pegue em: Neon Console > seu projeto > Connection Details > "Pooled connection"
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# URL do chatbot e Bearer token da API Suri.
# Definindo as duas aqui, a conexão fica fixa: o campo some da tela de Ajustes
# e não pode mais ser editado/sobrescrito pela UI.
SURI_CHATBOT_URL=https://sua-instancia.azurewebsites.net
SURI_BEARER_TOKEN=

# Painel de tickets ao vivo ("Carregar da SoftCS"): URL do SoftCS Bot e a
# mesma chave cadastrada lá como EXPORT_API_KEY. Ficam só no servidor
# (app/api/tickets/softcs/route.ts), nunca vão pro navegador.
SOFTCS_BOT_URL=https://softcs-bot.vercel.app
SOFTCS_BOT_EXPORT_KEY=
