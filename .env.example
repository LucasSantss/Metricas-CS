# Connection string do banco Neon (Postgres serverless)
# Pegue em: Neon Console > seu projeto > Connection Details > "Pooled connection"
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# URL do chatbot e Bearer token da API Suri.
# Definindo as duas aqui, a conexão fica fixa: o campo some da tela de Ajustes
# e não pode mais ser editado/sobrescrito pela UI.
SURI_CHATBOT_URL=https://sua-instancia.azurewebsites.net
SURI_BEARER_TOKEN=

# Painel de tickets ao vivo ("Carregar da SoftCS"): URL do SoftCS Bot e a
# mesma chave cadastrada lá como EXPORT_API_KEY. Ficam só no servidor
# (app/api/tickets/softcs/route.ts), nunca vão pro navegador.
SOFTCS_BOT_URL=https://softcs-bot.vercel.app
SOFTCS_BOT_EXPORT_KEY=

# Relatório de tickets (/relatorio-tickets): texto escrito pelo Gemini em cima
# dos números calculados pela plataforma. Chave em https://aistudio.google.com/apikey.
# Sem a chave, o relatório sai só com os números.
GEMINI_API_KEY=
# Opcional: modelo do Gemini (padrão gemini-2.5-flash)
GEMINI_MODEL=
# Protege o agendamento diário das 9h (vercel.json → /api/ticket-reports/cron).
# A Vercel manda esse valor sozinha no cabeçalho Authorization ao rodar o cron.
CRON_SECRET=

# Login (Auth.js): só contas Google @chatbotmaker.io entram (ver auth.ts).
# AUTH_SECRET: gere com `npx auth secret` (ou `openssl rand -base64 32`).
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: Google Cloud Console > APIs e serviços >
# Credenciais > ID do cliente OAuth (Aplicativo da Web), com o URI de
# redirecionamento https://SEU-DOMINIO/api/auth/callback/google
# (e http://localhost:3000/api/auth/callback/google pra rodar local).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
